# Import diagnostics, source evidence, and backups are local working files.
# The two catalogues below are required by LowPolyModelMaterialPostprocessor.cs.
/Tools/AssetImport/*
!/Tools/AssetImport/model-material-bindings.json
!/Tools/AssetImport/model-renderer-material-bindings.json
