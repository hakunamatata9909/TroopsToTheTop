# Assets uses an allowlist: source code, text-based Unity objects, and metadata.
# Re-include directories so Git can reach allowed files at any folder depth.
/Assets/**/*
!/Assets/**/
!/Assets/**/*.cs
!/Assets/**/*.asmdef
!/Assets/**/*.asmref
!/Assets/**/*.shader
!/Assets/**/*.hlsl
!/Assets/**/*.cginc
!/Assets/**/*.compute
!/Assets/**/*.raytrace
!/Assets/**/*.shadergraph
!/Assets/**/*.shadersubgraph
!/Assets/**/*.vfx
!/Assets/**/*.uss
!/Assets/**/*.uxml
!/Assets/**/*.inputactions
!/Assets/**/*.yaml
!/Assets/**/*.yml
!/Assets/**/*.unity
!/Assets/**/*.prefab
!/Assets/**/*.asset
!/Assets/**/*.mat
!/Assets/**/*.anim
!/Assets/**/*.controller
!/Assets/**/*.overridecontroller
!/Assets/**/*.playable
!/Assets/**/*.terrainlayer
!/Assets/**/*.mask
!/Assets/**/*.physicmaterial
!/Assets/**/*.physicsmaterial2d
!/Assets/**/*.preset
!/Assets/**/*.guiskin
!/Assets/**/*.rendertexture
!/Assets/**/*.shadervariants

# Metadata preserves GUIDs and import settings, including excluded resources.
# Restore the separate binary resources before opening a fresh Unity checkout.
!/Assets/**/*.meta

# Recovery scenes are local editor output, even though their contents are YAML.
/Assets/_Recovery/
/Assets/_Recovery.meta

# .asset is a mixed text/binary extension. These 15 files were checked as binary.
